{
  "name": "inoh-obsidian",
  "version": "0.0.45",
  "description": "Obsidian plugin that highlights words from your Inoh vocabulary deck while you write",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "pnpm typecheck && pnpm lint && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest run",
    "dev:local": "APP_ENV=local node esbuild.config.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "vocabulary",
    "inoh"
  ],
  "author": "Naka, Inc",
  "license": "MIT",
  "packageManager": "pnpm@10.18.3",
  "devDependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@eslint/js": "^10.0.1",
    "@types/fast-levenshtein": "^0.0.4",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.11.1",
    "obsidian": "^1.13.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.83.0",
    "fast-levenshtein": "^3.0.0"
  }
}
