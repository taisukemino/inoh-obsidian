# Per-machine settings. Copy to .env (gitignored).
# Only needed if your vault is not at ~/Obsidian, which `pnpm dev` tries first.
# Point this at the vault's root — the folder containing .obsidian/.
OBSIDIAN_VAULT=~/Documents/YourVault


# ---------------------------------------------------------------------------
# Backend selection, mirroring the Inoh app's APP_ENV convention.
# `.env.<APP_ENV>` is loaded on top of .env; APP_ENV defaults to prod.
#
#   pnpm dev        → prod project. Stripe LIVE — checkout charges a real card.
#   pnpm dev:local  → .env.local. Point it at a local Supabase stack for
#                     Stripe TEST mode (card 4242 4242 4242 4242).
#
# `pnpm build` ignores all of this and always targets prod.
#
# Copy the block below into .env.local — `supabase start` in inoh-backend
# prints both values.
# ---------------------------------------------------------------------------
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_PUBLISHABLE_KEY=
